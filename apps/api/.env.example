# Скопируй в apps/api/.env и подставь свои значения.

# PostgreSQL (локально или Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sevenbs?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# Bootstrap первого супер-админа (используется prisma db seed)
SUPERADMIN_EMAIL="admin@7bs.local"
SUPERADMIN_PASSWORD="change-me-strong"

# Порт API
PORT=4000
